# ============================================================
# 博客管理系统 - 环境变量配置模板
# 
# 使用方式：
#   cp .env.example .env
#   然后编辑 .env 填入实际值
# 
# 注意：.env 文件包含敏感信息，已在 .gitignore 中排除，请勿提交到仓库
# ============================================================

# 应用配置
APP_ENV=dev
APP_PORT=9000

# 注册功能开关（false=关闭，true=开放注册）
REGISTER_ENABLE=false

# MySQL 配置
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=ry-vue-py
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here

# Redis 配置
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# 上传目录
UPLOAD_DIR=./uploads

# DeepSeek AI 配置（密钥请到 DeepSeek 开放平台申请）
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 模型选择（deepseek-chat=标准，deepseek-flash=轻量省钱）
DEEPSEEK_MODEL=deepseek-chat